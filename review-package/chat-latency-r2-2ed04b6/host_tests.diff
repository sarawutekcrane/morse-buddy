+    FsStats a = g_fs;
+    T::connected = true;
+    runFor(10);
+    (void)listingsBefore;
+    CHECK(pendingCount(kBob) == 0 && pubsFor("msg/" + std::string(kBob)) == 1 && g_fs.dirOpens - a.dirOpens <= 1,
