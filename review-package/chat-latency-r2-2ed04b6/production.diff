+void patchIndexRemove(ConversationIndexEntry* arr, uint16_t* count, uint32_t seq) {
+  for (uint16_t i = 0; i < *count; i++) {
+    if (arr[i].sequence == seq) {
+      memmove(&arr[i], &arr[i + 1], sizeof(ConversationIndexEntry) * (*count - i - 1));
+      (*count)--;
+      return;
