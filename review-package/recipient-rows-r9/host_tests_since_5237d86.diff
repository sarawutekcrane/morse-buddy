+    else storeTextIn(kG, MessageStore::kEveryone, kBob, true, true, kDay06 + 60);
+    storeTextIn(kG, kBob, kBob, true, false, kDay06 + 60);
+    powerOn(); runFor(30);
+    presence(kG, kBob, "Bob");
+    TypeCount before = truth(kAbsent);
+    openMode(enigma);
+    std::vector<std::string> rows = listRows();
