+    runLoading(evs, 0);
+    loopPass(30);
+    bool warned1 = T::visibleJoined().find("Input lost while loading") != std::string::npos;
+    bool drafted = T::visibleJoined().find("SOS") != std::string::npos;
+    // A visit that did lose input, then a new visit.
